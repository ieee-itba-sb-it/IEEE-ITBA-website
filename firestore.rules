rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth.uid != null;
    }

    function hasRole(role) {
      let roles = {"admin": 1, "writer": 2, "member": 3};
      return isSignedIn() && roles[role] in get(/databases/$(database)/documents/sensitive-user-data/$(request.auth.token.email)).data.roles;
    }

    function isDataOwner() {
      return resource.data.uID == request.auth.uid;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    match /blog-entries/{document=**}  {
      allow read: if resource.data.listed == true || hasRole("writer") || hasRole("admin");
      allow write: if hasRole("writer") || hasRole("admin");
    }

    match /events/{eventId} {
      allow read;
      allow write: if hasRole("admin");
    }

    // subcolecciones de eventos (ej: questions); students y editions quedan excluidas de la lectura publica.
    // Esta regla tambien aplica a todo lo anidado en editions, por eso los admins pueden leer y escribir ahi
    match /events/{eventId}/{subcollection}/{document=**} {
      allow read: if (subcollection != "students" && subcollection != "editions") || hasRole("admin");
      allow write: if hasRole("admin");
    }

    function isOwnEmail(email) {
      return isSignedIn() && request.auth.token.email == email;
    }

    function studentPath(eventId, editionId, email) {
      return /databases/$(database)/documents/events/$(eventId)/editions/$(editionId)/students/$(email);
    }

    function metricsPath(eventId, editionId) {
      return /databases/$(database)/documents/events/$(eventId)/editions/$(editionId)/metrics/summary;
    }

    // Las metricas se suman exactamente una vez en el mismo commit que crea al alumno
    function isCountedInMetrics(eventId, editionId) {
      let path = metricsPath(eventId, editionId);
      let previousTotal = exists(path) ? get(path).data.total : 0;
      return existsAfter(path) && getAfter(path).data.total == previousTotal + 1;
    }

    function isValidNewStudent(eventId, editionId, email) {
      let data = request.resource.data;
      return data.keys().hasAll(['email', 'edition', 'firstName', 'lastName', 'enrolledAt', 'termsAcceptedAt',
                                 'sponsorDataSharing', 'passedCourse'])
        && data.keys().hasOnly(['email', 'edition', 'firstName', 'lastName', 'enrolledAt', 'termsAcceptedAt',
                                'sponsorDataSharing', 'linkedin', 'passedCourse'])
        && data.email == email
        && data.edition == editionId
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 100
        && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 100
        && data.enrolledAt == request.time
        && data.termsAcceptedAt == request.time
        && data.sponsorDataSharing is bool
        && (!('linkedin' in data) || (data.sponsorDataSharing == true && data.linkedin is string && data.linkedin.size() <= 200))
        && data.passedCourse == false
        && isCountedInMetrics(eventId, editionId);
    }

    // El documento de la edicion solo guarda su id, para que los admins puedan listar las ediciones sin leer alumnos.
    // Lo escribe el alumno en el mismo commit en que se inscribe
    match /events/{eventId}/editions/{editionId} {
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(['id'])
        && request.resource.data.id == editionId
        && !exists(studentPath(eventId, editionId, request.auth.token.email))
        && existsAfter(studentPath(eventId, editionId, request.auth.token.email));
    }

    // cada student accede solo a su propia informacion de la edicion; los admins leen y escriben todo (regla generica)
    match /events/{eventId}/editions/{editionId}/students/{userEmail} {
      allow read: if isOwnEmail(userEmail);
      allow create: if isOwnEmail(userEmail) && isValidNewStudent(eventId, editionId, userEmail);
      // Durante los examenes el alumno solo actualiza su examen y si aprobo
      allow update: if isOwnEmail(userEmail)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentExam', 'passedCourse']);
    }

    // Metricas anonimas: solo los admins las leen (regla generica). Un alumno solo puede sumar cuando se inscribe:
    // su documento no existia antes del commit y existe despues
    match /events/{eventId}/editions/{editionId}/metrics/{metricsId} {
      allow create, update: if isSignedIn()
        && metricsId == "summary"
        && !exists(studentPath(eventId, editionId, request.auth.token.email))
        && existsAfter(studentPath(eventId, editionId, request.auth.token.email))
        && request.resource.data.total == (resource == null ? 0 : resource.data.total) + 1
        && request.resource.data.keys().hasOnly(['total', 'gender', 'ageRange', 'country', 'occupation', 'itbaCareer',
                                                 'referralSource', 'motivation', 'programmingLanguage', 'pythonInterest']);
    }

    /*match /events/{eventId}/user_exams/{examId=**} {
        allow read;
        allow write;
    }*/

    match /collection-metadata/{document=**}   {
      allow read;
      allow write: if hasRole("admin");
    }

    match /team/{document=**}  {
      allow read;
      allow write: if hasRole("admin");
    }

    match /team-requests/{document=**} {
      allow read: if hasRole("admin");
      allow write: if isEmailVerified() || hasRole("admin");
    }

    match /commissions/{document=**}  {
      allow read;
      allow write: if hasRole("admin");
    }

    match /{path=**}/members/{member}  {
      allow read;
      allow write: if hasRole("admin") || hasRole("member");
    }

    match /users/{document=**}  {
        allow get, update, delete: if isDataOwner() || hasRole("admin");
      allow list: if hasRole("admin");
      // Solo puede crear el objeto usuario si el id del usuario en el body corresponde con el id del usuario en el token
      allow create: if (isSignedIn() && request.resource.data.uID == request.auth.uid) || hasRole("admin");
    }

    match /sensitive-user-data/{document=**} {
      allow read, write: if hasRole("admin");
    }

    // Asimov
    match /asimov-robots/{document=**}  {
      allow read;
      allow write: if hasRole("admin");
    }

    match /asimov-categories/{document=**}  {
      allow read;
      allow write: if hasRole("admin");
    }

    match /asimov-scores/{score}  {
      allow read;
      allow write;
      // TODO: multiple-categories refactor needed
//      allow write: if get(/databases/$(database)/documents/collection-metadata/asimov-scores).data.open || hasRole("admin");
    }

    match /{path=**}/predictions/{prediction}  {
      allow read;
    }

    match /asimov-scores/{userId}/predictions/{predictionId}  {
      allow read;
      // Solo se pueden crear predicciones si la categoria especifica esta abierta.
      allow write: if (isSignedIn() && request.auth.uid == userId
              && get(/databases/$(database)/documents/asimov-categories/$(request.resource.data.category.id)).data.predictionsOpen == true)
              || hasRole("admin");
    }

    match /asimov-encounters/{document=**}  {
      allow read;
      allow write: if hasRole("admin");
    }


    match /ieeextreme-teams/{document=**} {
      allow read: if true;
      allow write: if hasRole("admin");
    }

    match /{path=**}/comments/{comment} {
        allow read;
        allow create: if isSignedIn();
        allow delete: if hasRole("admin") || hasRole("writer") || isDataOwner();
    }
  }
}
